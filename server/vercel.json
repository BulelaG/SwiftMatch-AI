{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [{ "source": "/(.*)", "destination": "/api/index" }],
  "functions": {
    "api/index.js": {
      "memory": 1024,
      "maxDuration": 60,
      "excludeFiles": "node_modules/onnxruntime-node/bin/napi-v3/{darwin,win32}/**"
    }
  }
}
